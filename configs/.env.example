# 应用运行环境：development 或 production。
AOWUGONG_ENV=development

# HTTP 服务监听地址。
AOWUGONG_HTTP_ADDRESS=0.0.0.0:2345

# SQLite 运行数据库；生产固定放在 shared/storage/data。
AOWUGONG_SQLITE_PATH=storage/data/aowugong.db
AOWUGONG_SQLITE_MAX_OPEN_CONNS=4
AOWUGONG_SQLITE_MAX_IDLE_CONNS=2
AOWUGONG_SQLITE_BUSY_TIMEOUT_MS=5000
AOWUGONG_SQLITE_SKIP_MIGRATIONS=false

# 本地页面复用线上数据时填写线上 Go 根地址；生产必须留空。
AOWUGONG_DEV_UPSTREAM_URL=

# 旧 MySQL 只供 cmd/migrate 一次性读取，正式运行不使用这些配置。
AOWUGONG_MYSQL_HOST=127.0.0.1
AOWUGONG_MYSQL_PORT=3306
AOWUGONG_MYSQL_DATABASE=aowugong
AOWUGONG_MYSQL_USER=aowugong
AOWUGONG_MYSQL_PASSWORD=

# 前端静态文件目录。
AOWUGONG_STATIC_DIR=web/dist

# 留空时优先使用可执行文件同级 migrations，源码运行自动回退到仓库目录。
AOWUGONG_MIGRATIONS_DIR=

# 生产环境必须替换为安全随机值。
AOWUGONG_JWT_SECRET=replace-with-a-secure-jwt-secret
AOWUGONG_ENCRYPTION_KEY=replace-with-a-secure-encryption-key

# 私有导航、SQLite 备份和内嵌调度器。
AOWUGONG_WORK_NAVIGATION_PATH=storage/private/work/navigation.json
AOWUGONG_BACKUP_DIR=storage/backup
AOWUGONG_BACKUP_RETENTION=7
AOWUGONG_POSITION_UPLOAD_DIR=storage/uploads/positions
AOWUGONG_POSITION_TEMP_DIR=storage/temp/positions
AOWUGONG_SCHEDULER_ENABLED=false

# 微信读书。
WEREAD_GATEWAY_URL=https://i.weread.qq.com/api/agent/gateway
WEREAD_API_KEY=
WEREAD_SKILL_VERSION=1.0.4

# 投资文章通过 Miniflux API 读取；Monitor URL 只用于页面展示公网入口。
MINIFLUX_BASE_URL=http://127.0.0.1:5000
MINIFLUX_MONITOR_URL=http://8.138.123.59:5000/
MINIFLUX_API_TOKEN=
MINIFLUX_CATEGORY=投资文章

# 行情和模型分析。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
TUSHARE_BASE_URL=https://api.tushare.pro
TUSHARE_TOKEN=

# OpeniLink 微信通知。
OPENILINK_HUB_URL=http://127.0.0.1:9800
OPENILINK_MONITOR_URL=http://8.138.123.59:9800/
OPENILINK_APP_TOKEN=
OPENILINK_DEFAULT_TO=
OPENILINK_DB_PATH=/var/lib/openilink-hub/openilink.db

# 仓位截图 OCR 和服务监控。
POSITION_OCR_PROVIDER=aliyun
POSITION_UPLOAD_MAX_MB=10
ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
SERVICE_MONITOR_TARGETS=

# 真实交易默认关闭；仅明确切换时设置 true。
FINANCE_ENABLE_REAL_TRADE=false
QMT_ACCOUNT=
BINANCE_API_KEY=
OKX_API_KEY=
