# 应用运行环境：development 或 production。
AOWUGONG_ENV=development

# HTTP 服务监听地址。
AOWUGONG_HTTP_ADDRESS=127.0.0.1:12345

# PostgreSQL 运行数据库；生产使用服务器本机回环地址。
AOWUGONG_DATABASE_URL=postgres://aowugong:replace-with-a-secure-password@127.0.0.1:5432/aowugong?sslmode=disable
AOWUGONG_DATABASE_MAX_OPEN_CONNS=8
AOWUGONG_DATABASE_MAX_IDLE_CONNS=4
AOWUGONG_DATABASE_CONN_MAX_LIFETIME_MINUTES=30
AOWUGONG_DATABASE_SKIP_MIGRATIONS=false

# 只供首次 SQLite 到 PostgreSQL 迁移使用，正式运行不读取该文件。
AOWUGONG_SQLITE_SOURCE_PATH=storage/data/aowugong.db

# 本地页面复用线上数据时填写线上 Go 根地址；生产必须留空。
AOWUGONG_DEV_UPSTREAM_URL=

# 前端静态文件目录。
AOWUGONG_STATIC_DIR=web/dist

# 留空时优先使用可执行文件同级 migrations，源码运行自动回退到仓库目录。
AOWUGONG_MIGRATIONS_DIR=

# 生产环境必须替换为安全随机值。
AOWUGONG_JWT_SECRET=replace-with-a-secure-jwt-secret
AOWUGONG_ENCRYPTION_KEY=replace-with-a-secure-encryption-key

# 私有导航、PostgreSQL 备份和内嵌调度器。
AOWUGONG_WORK_NAVIGATION_PATH=storage/private/work/navigation.json
AOWUGONG_BACKUP_DIR=storage/backup
AOWUGONG_BACKUP_RETENTION=7
AOWUGONG_POSITION_UPLOAD_DIR=storage/uploads/positions
AOWUGONG_POSITION_TEMP_DIR=storage/temp/positions
AOWUGONG_SCHEDULER_ENABLED=false

# GitHub 代码冷备份；自动发现账号自有仓库，并额外备份下面两个组织仓库。
# Token 需具备账号全部仓库及两个组织仓库的只读权限，禁止提交真实值。
GITHUB_BACKUP_ENABLED=false
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REQUIRED_REPOSITORIES=KES-IT/KES-SCM,KES-IT/KES-BIS
# 留空时使用 AOWUGONG_BACKUP_DIR/github。
GITHUB_BACKUP_DIR=
GITHUB_BACKUP_RETENTION_REFS=4

# Vaultwarden 每周邮件备份；附件使用 age 公钥加密，私钥不得放在服务器或 Git。
VAULTWARDEN_BACKUP_EMAIL_ENABLED=false
VAULTWARDEN_BACKUP_DIR=storage/backup/vaultwarden
VAULTWARDEN_BACKUP_RECOVERY_SCRIPTS_DIR=scripts
VAULTWARDEN_BACKUP_AGE_RECIPIENT=
VAULTWARDEN_BACKUP_EMAIL_TO=825360699@qq.com
VAULTWARDEN_BACKUP_MAX_ATTACHMENT_MB=45

# VPN 私有配置仅从本机目录读取；公开地址必须是用户终端无需代理即可访问的 Go 服务根地址。
VPN_SOURCE_DIR=storage/private/vpn
VPN_PUBLIC_URL=https://8.138.123.59:2345

# QQ 邮箱使用 SMTP 授权码，不使用邮箱登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_EMAIL=
SMTP_PASSWORD=

# 微信读书。
WEREAD_GATEWAY_URL=https://i.weread.qq.com/api/agent/gateway
WEREAD_API_KEY=
WEREAD_SKILL_VERSION=1.0.4

# Miniflux 独立用于 RSS 阅读；以下地址用于服务监控和管理入口。
MINIFLUX_BASE_URL=http://127.0.0.1:5000
MINIFLUX_MONITOR_URL=http://8.138.123.59:5000/
MINIFLUX_API_TOKEN=
MINIFLUX_CATEGORY=投资文章

# 行情和模型分析。Sub2API 使用 OpenAI Responses API，真实 Key 不得提交。
SUB2API_BASE_URL=http://64.186.230.213:8080/v1
SUB2API_API_KEY=
SUB2API_MODELS=gpt-5.6-luna,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6
SUB2API_DEFAULT_MODEL=gpt-5.6-luna
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
TUSHARE_BASE_URL=https://api.tushare.pro
TUSHARE_TOKEN=

# OpeniLink 微信通知。
OPENILINK_HUB_URL=http://127.0.0.1:9800
OPENILINK_MONITOR_URL=http://8.138.123.59:9800/
OPENILINK_APP_TOKEN=
OPENILINK_DEFAULT_TO=
OPENILINK_DB_PATH=/var/lib/openilink-hub/openilink.db

# 仓位截图 OCR 和服务监控。
POSITION_OCR_PROVIDER=aliyun
POSITION_UPLOAD_MAX_MB=10
ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
SERVICE_MONITOR_TARGETS=

# 真实交易默认关闭；仅明确切换时设置 true。
FINANCE_ENABLE_REAL_TRADE=false
QMT_ACCOUNT=
BINANCE_API_KEY=
OKX_API_KEY=
