[Unit]
Description=Aowugong Go modular monolith
After=network-online.target local-fs.target docker.service mysqld.service
Wants=network-online.target

[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_GROUP@
WorkingDirectory=@APP_ROOT@/current
EnvironmentFile=@APP_ROOT@/shared/.env
ExecStart=@APP_ROOT@/current/aowugong
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=8192
MemoryLimit=256M
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
