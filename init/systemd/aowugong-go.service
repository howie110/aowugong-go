[Unit]
Description=Aowugong Go modular monolith
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_GROUP@
WorkingDirectory=@APP_ROOT@/current
EnvironmentFile=@APP_ROOT@/shared/.env
ExecStart=@APP_ROOT@/current/aowugong
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@APP_ROOT@/shared

[Install]
WantedBy=multi-user.target
